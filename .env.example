# Copy to .env for local development. Every value below is a placeholder.
# Generate a unique session secret and use your own approved Etsy API app.
PORT=3010
NODE_ENV=development
SITE_PASSWORD=replace-with-your-own-long-password
SESSION_SECRET=replace-with-your-own-random-session-secret

# Configure allowed browser origins for your host.
CORS_ORIGIN=http://localhost:3010

# Official Etsy Open API v3. Never commit real access or refresh tokens.
ETSY_API_KEY=
ETSY_CLIENT_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=

# AI providers. Optional: add keys only for features you use.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=
EXTERNAL_IMAGE_MODEL=
EXTERNAL_IMAGE_ADAPTER=
EXTERNAL_IMAGE_REFERENCE_MODE=unsupported

# Optional shared storage. Never expose secrets in client-side JavaScript.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional GPT Actions OAuth. Leave disabled until separately configured.
GPT_OAUTH_ISSUER=
GPT_OAUTH_CLIENT_ID=
GPT_OAUTH_CLIENT_SECRET=
GPT_OAUTH_REDIRECT_URIS=
GPT_OAUTH_TOKEN_HASH_SECRET=

# Optional companion message bridge, not bundled in this repository.
ETSY_MESSAGES_BRIDGE_URL=
ETSY_MESSAGES_BRIDGE_TOKEN=
ETSY_MESSAGES_BRIDGE_APPROVAL_TOKEN=
MESSAGE_AUTO_TRIGGERS_ENABLED=false
MESSAGE_TRIGGER_RUNNER_ENABLED=false
MESSAGE_TELEGRAM_NOTIFICATIONS_ENABLED=false
MESSAGE_LEARNING_CAPTURE_ENABLED=false
MESSAGE_LEARNING_ENABLED=false

# Social scheduling and publishing are disabled by default.
SOCIAL_OWNER_REVIEW_PRODUCER_ENABLED=false
AUTOPUBLISH_ENABLED=false
AUTOPUBLISH=false
REAL_PUBLISH_RELEASE_APPROVED=false
SOCIAL_AUTOPUBLISH_OWNER_OPT_IN=false
